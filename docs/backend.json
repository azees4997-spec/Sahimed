
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a patient registered in the HealthLink Pharmacy app.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the patient (Firebase UID)."
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "phoneNumber": {
          "type": "string"
        },
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "phoneNumber",
        "createdAt"
      ]
    },
    "AdminProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AdminProfile",
      "type": "object",
      "description": "Represents a clinical supervisor with administrative access.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the admin (Firebase UID)."
        },
        "role": {
          "type": "string",
          "enum": ["admin", "pharmacist"]
        },
        "activatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "role",
        "activatedAt"
      ]
    },
    "MoleculeMaster": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "MoleculeMaster",
      "type": "object",
      "description": "Unique Molecule ID Registry for linking bio-equivalents.",
      "properties": {
        "masterId": {
          "type": "string",
          "description": "Unique ID for the salt/molecule composition."
        },
        "molecule": {
          "type": "string",
          "description": "Full salt combination name."
        },
        "form": {
          "type": "string",
          "description": "Standard dosage form (e.g. Tablet, Syrup)."
        }
      },
      "required": ["masterId", "molecule", "form"]
    },
    "Medicine": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Medicine",
      "type": "object",
      "description": "Clinical product in the catalog.",
      "properties": {
        "sku": {
          "type": "string",
          "description": "Unique SKU for the product."
        },
        "moleculeId": {
          "type": "string",
          "description": "Reference to MoleculeMaster.masterId."
        },
        "name": {
          "type": "string"
        },
        "price": {
          "type": "number"
        },
        "mrp": {
          "type": "number"
        },
        "isGeneric": {
          "type": "boolean"
        },
        "saltComposition": {
          "type": "string"
        }
      }
    }
  },
  "auth": {
    "providers": [
      "phone",
      "anonymous",
      "password"
    ]
  },
  "firestore": {
    "/userProfiles/{userId}": {
      "schema": {
        "$ref": "#/backend/entities/UserProfile"
      },
      "description": "Stores patient profile data."
    },
    "/adminProfiles/{userId}": {
      "schema": {
        "$ref": "#/backend/entities/AdminProfile"
      },
      "description": "Stores clinical supervisor roles."
    },
    "/moleculeMaster/{moleculeId}": {
      "schema": {
        "$ref": "#/backend/entities/MoleculeMaster"
      },
      "description": "Global registry of clinical molecules."
    },
    "/medicines/{medicineId}": {
      "schema": {
        "$ref": "#/backend/entities/Medicine"
      },
      "description": "Public catalog of medicines."
    }
  }
}

{
  "entities": {
    "Customer": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Customer",
      "type": "object",
      "description": "Represents a user of the SahiMed application.",
      "properties": {
        "id": { "type": "string" },
        "firebaseAuthId": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "firebaseAuthId", "email", "name", "phone", "createdAt", "updatedAt"]
    },
    "Medicine": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Medicine",
      "type": "object",
      "description": "Represents a single medicine product with clinical data.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "moleculeId": { "type": "string", "description": "Mapping to Formula Registry" },
        "manufacturer": { "type": "string" },
        "saltComposition": { "type": "string" },
        "price": { "type": "number" },
        "mrp": { "type": "number" },
        "availableQuantity": { "type": "number" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string", "format": "uri" },
        "isGeneric": { "type": "boolean" },
        "prescriptionRequired": { "type": "boolean", "default": false },
        "packSize": { "type": "string" },
        "description": { "type": "string" },
        "howToUse": { "type": "string" },
        "treatment": { "type": "string" },
        "safetyAdvice": { "type": "string" },
        "sideEffects": { "type": "string" },
        "alcoholInteraction": { "type": "string" },
        "pregnancyInteraction": { "type": "string" },
        "lactationInteraction": { "type": "string" },
        "drivingInteraction": { "type": "string" },
        "kidneyInteraction": { "type": "string" },
        "liverInteraction": { "type": "string" }
      },
      "required": ["id", "name", "price", "category"]
    },
    "Molecule": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Molecule",
      "type": "object",
      "description": "Clinical formula definitions.",
      "properties": {
        "id": { "type": "string" },
        "molecule": { "type": "string" },
        "masterId": { "type": "string" },
        "form": { "type": "string" }
      },
      "required": ["id", "molecule", "masterId", "form"]
    },
    "Fee": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Fee",
      "type": "object",
      "description": "Represents a dynamic charge applied at the cart level.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["fixed", "percentage"] },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "name", "amount", "type", "isActive"]
    },
    "PromoCode": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "PromoCode",
      "type": "object",
      "description": "Represents a promotional discount code with clinical targeting.",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "description": { "type": "string" },
        "discountType": { "type": "string", "enum": ["fixed", "percentage"] },
        "discountValue": { "type": "number" },
        "minOrderValue": { "type": "number" },
        "applyTo": { "type": "string", "enum": ["cart", "product", "customer", "both"] },
        "targetId": { "type": "string", "description": "Specific Product ID or Customer ID if applicable" },
        "isActive": { "type": "boolean" },
        "validUntil": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "code", "discountType", "discountValue", "applyTo", "isActive"]
    },
    "SystemAlert": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "SystemAlert",
      "type": "object",
      "description": "Represents a system-wide clinical broadcast.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "message", "isActive"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous", "phone"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/fees/{feeId}",
        "definition": {
          "entityName": "Fee",
          "schema": { "$ref": "#/backend/entities/Fee" },
          "description": "Global clinical fees managed by admins."
        }
      },
      {
        "path": "/promocodes/{promoId}",
        "definition": {
          "entityName": "PromoCode",
          "schema": { "$ref": "#/backend/entities/PromoCode" },
          "description": "Promotional codes for patients."
        }
      },
      {
        "path": "/medicines/{medicineId}",
        "definition": {
          "entityName": "Medicine",
          "schema": { "$ref": "#/backend/entities/Medicine" },
          "description": "Catalog of medicines."
        }
      },
      {
        "path": "/moleculeMaster/{molId}",
        "definition": {
          "entityName": "Molecule",
          "schema": { "$ref": "#/backend/entities/Molecule" },
          "description": "Formula Registry."
        }
      },
      {
        "path": "/userProfiles/{userId}",
        "definition": {
          "entityName": "Customer",
          "schema": { "$ref": "#/backend/entities/Customer" },
          "description": "Patient profiles."
        }
      },
      {
        "path": "/stockEnquiries/{enquiryId}",
        "definition": {
          "entityName": "StockEnquiry",
          "schema": { "type": "object", "properties": { "medicineId": { "type": "string" }, "userId": { "type": "string" } } },
          "description": "Requests for out-of-stock items."
        }
      },
      {
        "path": "/systemAlerts/{alertId}",
        "definition": {
          "entityName": "SystemAlert",
          "schema": { "$ref": "#/backend/entities/SystemAlert" },
          "description": "System-wide broadcasts for patients."
        }
      }
    ]
  }
}

{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a patient registered in the HealthLink Pharmacy app.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the patient (Firebase UID)."
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "phoneNumber": {
          "type": "string"
        },
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "phoneNumber",
        "createdAt"
      ]
    },
    "AdminProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AdminProfile",
      "type": "object",
      "description": "Represents a clinical supervisor with administrative access.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the admin (Firebase UID)."
        },
        "role": {
          "type": "string",
          "enum": ["admin", "pharmacist"]
        },
        "activatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "role",
        "activatedAt"
      ]
    }
  },
  "auth": {
    "providers": [
      "phone",
      "anonymous",
      "password"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/userProfiles/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": {
            "$ref": "#/backend/entities/UserProfile"
          },
          "description": "Stores patient profile data.",
          "params": [
            {
              "name": "userId",
              "description": "Patient UID."
            }
          ]
        }
      },
      {
        "path": "/adminProfiles/{userId}",
        "definition": {
          "entityName": "AdminProfile",
          "schema": {
            "$ref": "#/backend/entities/AdminProfile"
          },
          "description": "Stores clinical supervisor roles.",
          "params": [
            {
              "name": "userId",
              "description": "Admin UID."
            }
          ]
        }
      },
      {
        "path": "/medicines/{medicineId}",
        "definition": {
          "entityName": "Medicine",
          "description": "Public catalog of medicines."
        }
      }
    ]
  }
}

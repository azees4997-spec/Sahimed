
{
  "entities": {
    "Customer": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Customer",
      "type": "object",
      "description": "Represents a user of the SahiMed application.",
      "properties": {
        "id": { "type": "string" },
        "firebaseAuthId": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "firebaseAuthId", "email", "name", "phone", "createdAt", "updatedAt"]
    },
    "Medicine": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Medicine",
      "type": "object",
      "description": "Represents a single medicine product with static clinical data.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "moleculeId": { "type": "string" },
        "manufacturer": { "type": "string" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string", "format": "uri" },
        "imageUrls": { "type": "array", "items": { "type": "string" } },
        "isGeneric": { "type": "boolean" },
        "prescriptionRequired": { "type": "boolean", "default": false },
        "packSize": { "type": "string" },
        "description": { "type": "string" },
        "howToUse": { "type": "string" },
        "treatment": { "type": "string" },
        "safetyAdvice": { "type": "string" },
        "sideEffects": { "type": "string" },
        "alcoholInteraction": { "type": "string" },
        "pregnancyInteraction": { "type": "string" },
        "lactationInteraction": { "type": "string" },
        "drivingInteraction": { "type": "string" },
        "kidneyInteraction": { "type": "string" },
        "liverInteraction": { "type": "string" }
      },
      "required": ["id", "name", "category"]
    },
    "ProductLiveData": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ProductLiveData",
      "type": "object",
      "description": "Dynamic pricing and stock data for a medicine.",
      "properties": {
        "mrp": { "type": "number" },
        "sahimed_price": { "type": "number" },
        "stock_quantity": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["mrp", "sahimed_price", "stock_quantity"]
    },
    "Category": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Category",
      "type": "object",
      "description": "Medicine category for therapeutic classification.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string", "format": "uri" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name"]
    },
    "Molecule": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Molecule",
      "type": "object",
      "description": "Clinical formula definitions.",
      "properties": {
        "id": { "type": "string" },
        "molecule": { "type": "string" },
        "masterId": { "type": "string" },
        "form": { "type": "string" }
      },
      "required": ["id", "molecule", "masterId", "form"]
    },
    "Fee": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Fee",
      "type": "object",
      "description": "Represents a dynamic charge applied at the cart level.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["fixed", "percentage"] },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "name", "amount", "type", "isActive"]
    },
    "PromoCode": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "PromoCode",
      "type": "object",
      "description": "Represents a promotional discount code.",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "description": { "type": "string" },
        "discountType": { "type": "string", "enum": ["fixed", "percentage"] },
        "discountValue": { "type": "number" },
        "minOrderValue": { "type": "number" },
        "applyTo": { "type": "string", "enum": ["cart", "product", "customer", "both"] },
        "targetId": { "type": "string" },
        "isActive": { "type": "boolean" },
        "validUntil": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "code", "discountType", "discountValue", "applyTo", "isActive"]
    },
    "Banner": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Banner",
      "type": "object",
      "description": "Storefront promotional banners.",
      "properties": {
        "id": { "type": "string" },
        "imageUrl": { "type": "string", "format": "uri" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "hindiTagline": { "type": "string" },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "imageUrl", "isActive"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous", "phone"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/fees/{feeId}",
        "definition": {
          "entityName": "Fee",
          "schema": { "$ref": "#/backend/entities/Fee" },
          "description": "Global clinical fees."
        }
      },
      {
        "path": "/categories/{categoryId}",
        "definition": {
          "entityName": "Category",
          "schema": { "$ref": "#/backend/entities/Category" },
          "description": "Therapeutic category registry."
        }
      },
      {
        "path": "/promocodes/{promoId}",
        "definition": {
          "entityName": "PromoCode",
          "schema": { "$ref": "#/backend/entities/PromoCode" },
          "description": "Promotional codes."
        }
      },
      {
        "path": "/medicines/{medicineId}",
        "definition": {
          "entityName": "Medicine",
          "schema": { "$ref": "#/backend/entities/Medicine" },
          "description": "Static catalog of medicines."
        }
      },
      {
        "path": "/product_live_data/{sku}",
        "definition": {
          "entityName": "ProductLiveData",
          "schema": { "$ref": "#/backend/entities/ProductLiveData" },
          "description": "Live pricing and inventory triad."
        }
      },
      {
        "path": "/moleculeMaster/{molId}",
        "definition": {
          "entityName": "Molecule",
          "schema": { "$ref": "#/backend/entities/Molecule" },
          "description": "Formula Registry."
        }
      },
      {
        "path": "/userProfiles/{userId}",
        "definition": {
          "entityName": "Customer",
          "schema": { "$ref": "#/backend/entities/Customer" },
          "description": "Patient profiles."
        }
      },
      {
        "path": "/stockEnquiries/{enquiryId}",
        "definition": {
          "entityName": "StockEnquiry",
          "schema": { "type": "object", "properties": { "medicineId": { "type": "string" }, "userId": { "type": "string" } } },
          "description": "Requests for out-of-stock items."
        }
      },
      {
        "path": "/banners/{bannerId}",
        "definition": {
          "entityName": "Banner",
          "schema": { "$ref": "#/backend/entities/Banner" },
          "description": "Storefront promotional banners."
        }
      }
    ]
  }
}

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper: Check if user is admin via Firestore
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid in ["BM9HheYflheT0Wyj6olaEnyCAHl1", "RzB6nqlQumg1VEniFcZrgbcDdRA2"] ||
        firestore.exists(/databases/(default)/documents/adminProfiles/$(request.auth.uid))
      );
    }

    // 1. AUTHENTICATED USER PRESCRIPTIONS
    // Users can only access their own labeled folders.
    match /prescriptions/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin();
    }

    // 2. SYSTEM ASSETS (Banners, Categories, Products, Branding)
    // Publicly readable, writeable ONLY by admins.
    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /branding/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. DEFAULT SYSTEM RULES
    // Ensure all other paths are only accessible by authenticated users for reading.
    // Explicitly restrict writing to admins or owners of specific sub-paths.
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}

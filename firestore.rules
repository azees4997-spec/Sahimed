rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid in ["BM9HheYflheT0Wyj6olaEnyCAHl1", "RzB6nqlQumg1VEniFcZrgbcDdRA2"] ||
        (exists(/databases/$(database)/documents/adminProfiles/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/adminProfiles/$(request.auth.uid)).data.role in ['admin', 'pharmacist', 'sub-admin'])
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- COLLECTION RULES ---

    // 1. ADMIN PROFILES
    match /adminProfiles/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // 2. USER DATA
    match /userProfiles/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      match /addresses/{id} { allow read, write: if isOwner(userId) || isAdmin(); }
      match /cartItems/{id} { allow read, write: if isOwner(userId); }
      match /familyMembers/{id} { allow read, write: if isOwner(userId) || isAdmin(); }
      match /orders/{id} { allow read: if isOwner(userId) || isAdmin(); allow write: if isAdmin(); }
      match /prescriptions/{id} { allow read: if isOwner(userId) || isAdmin(); allow write: if isOwner(userId) || isAdmin(); }
    }

    // 3. CATALOG & CONTENT (Public Read, Admin Write)
    match /products/{id} { allow read: if true; allow write: if isAdmin(); }
    match /medicines/{id} { allow read: if true; allow write: if isAdmin(); }
    match /moleculeMaster/{id} { allow read: if true; allow write: if isAdmin(); }
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /banners/{id} { allow read: if true; allow write: if isAdmin(); }
    match /marketing_missions/{id} { allow read: if true; allow write: if isAdmin(); }
    match /pages/{id} { allow read: if true; allow write: if isAdmin(); }
    match /fees/{id} { allow read: if true; allow write: if isAdmin(); }
    match /systemAlerts/{id} { allow read: if true; allow write: if isAdmin(); }
    match /promocodes/{id} { allow read: if true; allow write: if isAdmin(); }

    // 3b. SETTINGS (App config, logo URL, etc.) — Public read, Admin write
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }

    // 4. TRANSACTIONAL DATA
    match /carts/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // 5. ENQUIRIES & ALERTS
    match /stockAlerts/{id} { allow create: if true; allow read, write: if isAdmin(); }
    match /stockEnquiries/{id} { allow create: if isSignedIn(); allow read, write: if isAdmin(); }

    // --- COLLECTION GROUP RULES ---
    match /{path=**}/orders/{id} { allow list: if isAdmin(); }
    match /{path=**}/prescriptions/{id} { allow list: if isAdmin(); }
  }
}

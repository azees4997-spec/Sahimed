
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * SAHIMED PHARMACY SECURITY RULES
     * 
     * Enforces strict User-Ownership for sensitive patient data while allowing
     * public access to the clinical catalog, pricing data, and system alerts.
     */

    // --- GLOBAL HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** @description Checks if the user is a verified clinical supervisor/admin. */
    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/adminProfiles/$(request.auth.uid)) &&
             (get(/databases/$(database)/documents/adminProfiles/$(request.auth.uid)).data.role == 'admin' || 
              get(/databases/$(database)/documents/adminProfiles/$(request.auth.uid)).data.role == 'pharmacist');
    }

    // --- COLLECTION RULES ---

    match /userProfiles/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      match /addresses/{addressId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update, delete: if isOwner(userId);
      }

      match /cartItems/{cartItemId} {
        allow get, list: if isOwner(userId);
        allow create, update, delete: if isOwner(userId);
      }

      match /orders/{orderId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) || isAdmin(); 
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }

      match /prescriptions/{prescriptionId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin();
      }
    }

    // Clinical catalog: Publicly readable for the storefront
    match /medicines/{medicineId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Live pricing: Publicly readable for live stock/price updates
    match /product_live_data/{sku} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /moleculeMaster/{molId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /promocodes/{promoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /fees/{feeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /systemAlerts/{alertId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Storefront Banners: Publicly readable for the hero carousel
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // CMS Pages: Publicly readable for the Legal Footer and Header Links
    match /pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /stockEnquiries/{enquiryId} {
      allow create: if isSignedIn();
      allow read, write: if isAdmin();
    }

    match /adminProfiles/{adminId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // --- COLLECTION GROUP RULES ---
    
    match /{path=**}/orders/{orderId} {
      allow list: if isAdmin();
    }
    match /{path=**}/prescriptions/{prescriptionId} {
      allow list: if isAdmin();
    }
  }
}

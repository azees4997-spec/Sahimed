rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * HEALTHLINK PHARMACY SECURITY RULES
     * 
     * CORE PHILOSOPHY:
     * This ruleset enforces a strict user-ownership model using path-based authorization. 
     * Access to sensitive user data (profiles, addresses, prescriptions, orders, carts) is 
     * primarily determined by comparing the user's authenticated UID against the document's 
     * path or an internal ownership field.
     */

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    // --- COLLECTION GROUP RULES ---
    
    // Explicitly allow administrators to query orders and prescriptions across all users
    match /{path=**}/orders/{orderId} {
      allow read: if isAdmin();
    }

    match /{path=**}/prescriptions/{prescriptionId} {
      allow read: if isAdmin();
    }

    // --- TOP-LEVEL COLLECTIONS ---

    match /userProfiles/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);

      match /addresses/{addressId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(userId);
      }

      match /prescriptions/{prescriptionId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if (isExistingOwner(userId) || isAdmin()) && (request.resource.data.userId == resource.data.userId);
        allow delete: if isExistingOwner(userId);
      }

      match /orders/{orderId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if (isExistingOwner(userId) || isAdmin()) && (request.resource.data.userId == resource.data.userId);
        allow delete: if false; 

        match /orderItems/{orderItemId} {
          allow get, list: if isOwner(userId) || isAdmin();
          allow create: if isOwner(userId);
          allow update, delete: if false;
        }
      }
    }

    match /roles_admin/{userId} {
      // Allow a user to check if they are an admin
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow write: if false; 
    }

    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /manufacturers/{manufacturerId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /medicines/{medicineId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /userCarts/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);

      match /cartItems/{cartItemId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isExistingOwner(userId);
        allow delete: if isExistingOwner(userId);
      }
    }
  }
}
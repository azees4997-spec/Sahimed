
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * HEALTHLINK PHARMACY SECURITY RULES
     * 
     * CORE PHILOSOPHY:
     * 1. Path-based authorization for private user data.
     * 2. Role-based global access for administrators (DBAC).
     * 3. Public access for product catalogs.
     */

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- COLLECTION GROUP RULES ---
    
    // Explicitly allow administrators to query and update orders across all users for fulfillment
    match /{path=**}/orders/{orderId} {
      allow read, update: if isAdmin();
    }

    match /{path=**}/prescriptions/{prescriptionId} {
      allow read, update: if isAdmin();
    }

    // --- TOP-LEVEL COLLECTIONS ---

    // User Profiles & Private Data
    match /userProfiles/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);

      // Orders: User can only see theirs, Admin can see all (via group and direct path)
      match /orders/{orderId} {
        allow read, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update: if isAdmin(); // Admin updates fulfillment status
        
        match /orderItems/{itemId} {
          allow read: if isOwner(userId) || isAdmin();
          allow create: if isOwner(userId);
        }
      }

      // Prescriptions
      match /prescriptions/{prescriptionId} {
        allow read, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update: if isAdmin();
      }

      // Addresses
      match /addresses/{addressId} {
        allow read, list: if isOwner(userId);
        allow write: if isOwner(userId);
      }
    }

    // Admin Roles (Read-only for users to verify their own role, write restricted)
    match /roles_admin/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow write: if false; 
    }

    // Public Product Master (Read for all, write for Admin)
    match /medicines/{medicineId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /manufacturers/{manufacturerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Shopping Carts (Strictly private)
    match /userCarts/{userId} {
      allow read, write: if isOwner(userId);
      match /cartItems/{itemId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}

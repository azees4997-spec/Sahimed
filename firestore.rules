rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * HEALTHLINK PHARMACY SECURITY RULES
     * 
     * CORE PHILOSOPHY:
     * This ruleset enforces a strict user-ownership model using path-based authorization. 
     * Access to sensitive user data (profiles, addresses, prescriptions, orders, carts) is 
     * primarily determined by comparing the user's authenticated UID against the document's 
     * path or an internal ownership field.
     * 
     * DATA STRUCTURE:
     * - User-specific data is stored under `/userProfiles/{userId}` or `/userCarts/{userId}`.
     * - Global product data (medicines, categories, manufacturers) is stored in top-level collections.
     * - Administrative roles are decoupled from user profiles and stored in `/roles_admin/{userId}`.
     * 
     * KEY SECURITY DECISIONS:
     * - DBAC (Database Access Control): Admin status is checked by the existence of a document 
     *   in the `/roles_admin` collection rather than a field within the user's profile.
     * - Path-Based Authorization: By nesting user data under their UID, we eliminate the need 
     *   for cross-document lookups (get() calls) for most ownership checks.
     * - Public Read / Admin Write: Product catalogs are publicly viewable but strictly 
     *   managed by administrators.
     * - Order/Prescription Visibility: Administrators are granted read access to user orders 
     *   and prescriptions for processing and fulfillment.
     * 
     * PROTOTYPING MODE:
     * These rules prioritize strict authorization (who can access what) while remaining 
     * flexible on the internal data shape of documents to allow for rapid development.
     */

    // --- HELPER FUNCTIONS ---

    /** @description Checks if the user is authenticated. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** @description Checks if the authenticated user matches the provided ID. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** @description Checks if the user is a registered administrator via DBAC. */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /** @description Combines ownership and existence checks for state-changing operations. */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    // --- COLLECTION RULES ---

    /**
     * @description User profile management. Owners manage their profiles; admins can list all.
     * @path /userProfiles/{userId}
     * @allow (get) If user is owner or admin.
     * @deny (list) If user is not an admin.
     * @principle Path-based ownership.
     */
    match /userProfiles/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);

      /**
       * @description Delivery addresses owned by the user.
       * @path /userProfiles/{userId}/addresses/{addressId}
       * @allow (create) If owner and userId in data matches path.
       * @deny (update) If attempting to change ownership field (userId).
       */
      match /addresses/{addressId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(userId);
      }

      /**
       * @description Prescriptions uploaded by the user. Admins can view for verification.
       * @path /userProfiles/{userId}/prescriptions/{prescriptionId}
       * @allow (get) If owner or admin.
       */
      match /prescriptions/{prescriptionId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if (isExistingOwner(userId) || isAdmin()) && (request.resource.data.userId == resource.data.userId);
        allow delete: if isExistingOwner(userId);
      }

      /**
       * @description User order history. Admins can view for fulfillment.
       * @path /userProfiles/{userId}/orders/{orderId}
       */
      match /orders/{orderId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if (isExistingOwner(userId) || isAdmin()) && (request.resource.data.userId == resource.data.userId);
        allow delete: if false; // Orders are generally immutable for record keeping

        match /orderItems/{orderItemId} {
          allow get, list: if isOwner(userId) || isAdmin();
          allow create: if isOwner(userId);
          allow update, delete: if false;
        }
      }
    }

    /**
     * @description Global admin role management.
     * @path /roles_admin/{userId}
     * @principle DBAC (Database Access Control) - existence defines role.
     */
    match /roles_admin/{userId} {
      allow get, list: if isAdmin();
      allow write: if false; // Admin roles usually managed via Admin SDK/Cloud Functions
    }

    /**
     * @description Publicly readable catalog of medicine categories.
     * @path /categories/{categoryId}
     */
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Publicly readable catalog of manufacturers.
     * @path /manufacturers/{manufacturerId}
     */
    match /manufacturers/{manufacturerId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Publicly readable medicine catalog.
     * @path /medicines/{medicineId}
     */
    match /medicines/{medicineId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description User-specific shopping carts.
     * @path /userCarts/{userId}
     */
    match /userCarts/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);

      /**
       * @description Items within a user's cart.
       * @path /userCarts/{userId}/cartItems/{cartItemId}
       */
      match /cartItems/{cartItemId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isExistingOwner(userId);
        allow delete: if isExistingOwner(userId);
      }
    }
  }
}
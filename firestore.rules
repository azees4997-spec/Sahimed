
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * HEALTHLINK PHARMACY SECURITY RULES
     * Strict Authorization Independence & Sequential Gating
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Existence-over-Content check for admin role in the new adminProfiles collection
      return isSignedIn() && exists(/databases/$(database)/documents/adminProfiles/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- COLLECTION GROUP RULES ---
    // Specifically allow admins to perform collection-group queries for global monitoring
    match /{path=**}/orders/{orderId} {
      allow read, list, update: if isAdmin();
    }
    
    match /{path=**}/prescriptions/{prescriptionId} {
      allow read, list, update: if isAdmin();
    }

    // --- TOP-LEVEL COLLECTIONS ---

    match /userProfiles/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);

      match /orders/{orderId} {
        allow read, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update: if isAdmin(); 
      }

      match /prescriptions/{prescriptionId} {
        allow read, list, create: if isOwner(userId);
        allow update: if isOwner(userId) || isAdmin();
      }

      match /addresses/{addressId} {
        allow read, list, write: if isOwner(userId);
      }
    }

    match /adminProfiles/{userId} {
      // Allow self-read for verification; list for existing admins
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      // Bootstrap: Allow initial creation by any authenticated user for clinical setup
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /medicines/{medicineId} {
      allow read: if true; // Public catalog access
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true; // Public category access
      allow write: if isAdmin();
    }

    match /userCarts/{userId} {
      allow read, write: if isOwner(userId);
      match /cartItems/{itemId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}


rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * HEALTHLINK PHARMACY SECURITY RULES
     * Strict Authorization Independence & Sequential Gating
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/adminProfiles/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- COLLECTION GROUP RULES ---
    // Specifically gated for verified admins to perform clinical auditing
    match /{path=**}/orders/{orderId} {
      allow read, list, write: if isAdmin();
    }
    
    match /{path=**}/prescriptions/{prescriptionId} {
      allow read, list, write: if isAdmin();
    }

    // --- TOP-LEVEL COLLECTIONS ---

    match /userProfiles/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();

      match /orders/{orderId} {
        allow read, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) || isAdmin();
        allow update: if isAdmin(); 
      }

      match /prescriptions/{prescriptionId} {
        allow read, list, create: if isOwner(userId) || isAdmin();
        allow update: if isOwner(userId) || isAdmin();
      }

      match /addresses/{addressId} {
        allow read, list, write: if isOwner(userId);
      }
    }

    match /adminProfiles/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn(); // Allow initial self-registration
      allow update, delete: if isAdmin();
    }

    match /moleculeMaster/{moleculeId} {
      allow get, list: if true; // Public catalog reference
      allow write: if isAdmin();
    }

    match /medicines/{medicineId} {
      allow get, list: if true; // Public product browsing
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /userCarts/{userId} {
      allow read, write: if isOwner(userId);
      match /cartItems/{itemId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
